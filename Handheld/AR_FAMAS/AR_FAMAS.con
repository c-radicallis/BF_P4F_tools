rem FAMAS
rem Weapon CON File for AR_FAMAS (3120)

ObjectTemplate.create GenericFireArm AR_FAMAS
ObjectTemplate.assetId 3120
ObjectTemplate.saveInSeparateFile 1
ObjectTemplate.weaponsItemType WITAssaultRifle

ObjectTemplate.geometry ar_famas_custom

rem Fallback geometry
ObjectTemplate.fallbackGeometry 
ObjectTemplate.fallbackAnimationSystem1p 
ObjectTemplate.fallbackAnimationSystem3p 

GeometryTemplate.setSubGeometryLodDistance 1 0 5
GeometryTemplate.setSubGeometryLodDistance 1 1 15
