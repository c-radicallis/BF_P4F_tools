rem XM8AR
rem Weapon CON File for LMG_XM8AR_Default (3076)

ObjectTemplate.create GenericFireArm LMG_XM8AR_Default
ObjectTemplate.assetId 3076
ObjectTemplate.saveInSeparateFile 1
ObjectTemplate.weaponsItemType WITLightMachineGun

ObjectTemplate.geometry mg_xm8ar_custom

rem Fallback geometry
ObjectTemplate.fallbackGeometry 
ObjectTemplate.fallbackAnimationSystem1p 
ObjectTemplate.fallbackAnimationSystem3p 

GeometryTemplate.setSubGeometryLodDistance 1 0 5
